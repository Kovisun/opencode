# Copy this file to .env and fill in your values
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id

# Proxy (optional, for Telegram API access behind proxy)
HTTPS_PROXY=http://proxy:port
NO_PROXY=127.0.0.1,localhost,opencode.ai
TELEGRAM_PROXY_URL=http://proxy:port

# OpenCode model config
OPENCODE_MODEL_PROVIDER=openai
OPENCODE_MODEL_ID=gpt-4

# Bot settings
BOT_LOCALE=en
LOG_LEVEL=info
